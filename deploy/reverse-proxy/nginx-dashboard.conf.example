# AgroEdge dashboard — HTTPS reverse proxy (nginx)
#
# 1. Obtain TLS certs (e.g. certbot --nginx -d dashboard.example.com).
# 2. Copy this file to /etc/nginx/sites-available/agroedge-dashboard
#    and symlink to sites-enabled.
# 3. Bind the Flask/Gunicorn app to 127.0.0.1:5000 only.

upstream agroedge_dashboard {
	server 127.0.0.1:5000;
	keepalive 32;
}

server {
	listen 443 ssl http2;
	server_name dashboard.example.com;

	ssl_certificate     /etc/letsencrypt/live/dashboard.example.com/fullchain.pem;
	ssl_certificate_key /etc/letsencrypt/live/dashboard.example.com/privkey.pem;
	include /etc/letsencrypt/options-ssl-nginx.conf;
	ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

	add_header Strict-Transport-Security "max-age=63072000" always;
	add_header X-Content-Type-Options nosniff always;
	add_header X-Frame-Options SAMEORIGIN always;

	location / {
		proxy_pass         http://agroedge_dashboard;
		proxy_http_version 1.1;
		proxy_set_header   Host $host;
		proxy_set_header   X-Real-IP $remote_addr;
		proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header   X-Forwarded-Proto $scheme;
		proxy_set_header   Connection "";
		proxy_read_timeout  120s;
	}
}

server {
	listen 80;
	server_name dashboard.example.com;
	return 301 https://$host$request_uri;
}
