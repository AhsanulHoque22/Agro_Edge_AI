# AgroEdge runtime scheduler — production environment
# Copy to /etc/agroedge/runtime.env (or another path) and set values.
# Reference from systemd: EnvironmentFile=/etc/agroedge/runtime.env
#
# Never commit real secrets.

# ── Paths (adjust to your Pi install) ───────────────────────────────────────
# AGROEDGE_HOME=/home/pi/agroedge_ai
# PYTHON_BIN=/home/pi/agroedge_ai/.venv/bin/python

# ── ThingSpeak (required for live mode) ─────────────────────────────────────
THINGSPEAK_BASE_URL=https://api.thingspeak.com
THINGSPEAK_ENV_CHANNEL_ID=
THINGSPEAK_ENV_READ_API_KEY=
THINGSPEAK_IRRIGATION_CHANNEL_ID=
THINGSPEAK_IRRIGATION_WRITE_API_KEY=

# ── Farm / node defaults ────────────────────────────────────────────────────
DEFAULT_FARM_ID=farm_001
DEFAULT_FIELD_ID=field_001
DEFAULT_NODE_ID=node_esp32_001

# Optional overrides for scheduler (also pass via systemd ExecStart flags)
# PLANTING_DATE=2025-01-01
# DAYS_SINCE_LAST_IRRIGATION=2
# BUNDLE_VERSION=v1.0.0
# LOG_PATH=logs/runtime_cycles.jsonl
# INTERVAL_SECONDS=900
