# Example: dashboard behind Gunicorn (recommended for always-on Pi).
# Install: sudo cp deploy/systemd/agroedge-dashboard-gunicorn.service.example \
#            /etc/systemd/system/agroedge-dashboard.service
# Adjust User/Group/paths; chmod +x scripts/run_dashboard_gunicorn.sh

[Unit]
Description=AgroEdge monitoring dashboard (Gunicorn)
Documentation=file:///home/pi/agroedge_ai/docs/DEPLOYMENT.md
After=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/agroedge_ai
EnvironmentFile=-/etc/agroedge/runtime.env
Environment=PYTHONUNBUFFERED=1
Environment=AGROEDGE_RUNTIME_LOG=logs/runtime_cycles.jsonl
Environment=FLASK_RUN_HOST=0.0.0.0
Environment=FLASK_RUN_PORT=5000
Environment=GUNICORN_WORKERS=2
Environment=GUNICORN_THREADS=2

ExecStart=/home/pi/agroedge_ai/scripts/run_dashboard_gunicorn.sh

Restart=on-failure
RestartSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=agroedge-dashboard

[Install]
WantedBy=multi-user.target
