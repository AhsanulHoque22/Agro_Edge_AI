[Unit]
Description=AgroEdge local monitoring dashboard (Flask)
Documentation=file:///home/pi/agroedge_ai/docs/DEPLOYMENT.md
After=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/agroedge_ai
EnvironmentFile=-/etc/agroedge/runtime.env
Environment=PYTHONUNBUFFERED=1
Environment=AGROEDGE_RUNTIME_LOG=logs/runtime_cycles.jsonl
Environment=FLASK_RUN_HOST=0.0.0.0
Environment=FLASK_RUN_PORT=5000

ExecStart=/home/pi/agroedge_ai/.venv/bin/python /home/pi/agroedge_ai/scripts/run_dashboard.py

Restart=on-failure
RestartSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=agroedge-dashboard

[Install]
WantedBy=multi-user.target
