[Unit]
Description=AgroEdge AI runtime scheduler (ThingSpeak poll + irrigation decision loop)
Documentation=file:///home/pi/agroedge_ai/docs/DEPLOYMENT.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi

# Install tree: copy repo to e.g. /home/pi/agroedge_ai and create venv there.
WorkingDirectory=/home/pi/agroedge_ai

# Load secrets and overrides (create from deploy/agroedge-runtime.env.example)
EnvironmentFile=-/etc/agroedge/runtime.env

# Default interpreter; override in runtime.env with PYTHON_BIN if needed
Environment=PYTHONUNBUFFERED=1

# ExecStart: customize flags per deployment.
#  - Remove --publish-log until ThingSpeak irrigation channel is verified.
#  - Use --interval-seconds 900 (15 min) to match ESP32 cadence.
ExecStart=/home/pi/agroedge_ai/.venv/bin/python /home/pi/agroedge_ai/scripts/runtime_scheduler.py \
  --publish-log \
  --interval-seconds 900 \
  --log-path logs/runtime_cycles.jsonl \
  --bundle-version v1.0.0

# Restart policy: recover from transient network/API failures
Restart=on-failure
RestartSec=60
StartLimitBurst=5
StartLimitIntervalSec=300

# Hardening (optional; tighten further per your distro)
NoNewPrivileges=true
PrivateTmp=true

# Journal + local JSONL logs
StandardOutput=journal
StandardError=journal
SyslogIdentifier=agroedge-runtime

[Install]
WantedBy=multi-user.target
