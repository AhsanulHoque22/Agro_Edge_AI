# AgroEdge AI — Environment Variables Template
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── ThingSpeak: Environmental Sensors Channel ─────────────────────────────────
THINGSPEAK_ENV_CHANNEL_ID=
THINGSPEAK_ENV_WRITE_API_KEY=
THINGSPEAK_ENV_READ_API_KEY=

# ── ThingSpeak: Irrigation Log Channel ────────────────────────────────────────
THINGSPEAK_IRRIGATION_CHANNEL_ID=
THINGSPEAK_IRRIGATION_WRITE_API_KEY=
THINGSPEAK_IRRIGATION_READ_API_KEY=

# ── ThingSpeak Base URL (do not change unless using a private server) ─────────
THINGSPEAK_BASE_URL=https://api.thingspeak.com

# ── ThingSpeak web UI (for dashboard links only; not the REST API host) ──────
# AGROEDGE_THINGSPEAK_WEB_BASE=https://thingspeak.com

# ── Default Farm / Field / Node Identifiers ───────────────────────────────────
DEFAULT_FARM_ID=farm_001
DEFAULT_FIELD_ID=field_001
DEFAULT_NODE_ID=node_esp32_001

# ── Dashboard (optional HTTP Basic) ───────────────────────────────────────────
# Use only with HTTPS or trusted LAN. /health stays public for probes.
# AGROEDGE_DASHBOARD_BASIC_USER=agroedge
# AGROEDGE_DASHBOARD_BASIC_PASSWORD=change-me

# Disease model directory for POST /api/disease/predict (optional)
# AGROEDGE_DISEASE_BUNDLE=model_export/disease_model/v0.1.0
